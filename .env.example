# Letta Environment Variables
# 
# This file contains all the API keys and environment variables needed to run Letta and its test suite.
# Copy this file to `.env` and fill in your actual API keys.
#
# IMPORTANT: Never commit your actual `.env` file to version control!

# ==========================================
# CORE LLM PROVIDER API KEYS
# ==========================================
# These are the main LLM providers used by Letta and its tests

# OpenAI - Required for most tests and default Letta operation
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: Use custom endpoint

# Anthropic Claude - Required for Anthropic-specific tests and Claude models
# Get your key at: https://console.anthropic.com/account/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini) - Required for Gemini tests and Google AI models
# Get your key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/

# Google Vertex AI - Alternative to Google AI for enterprise
# Set up at: https://cloud.google.com/vertex-ai
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ==========================================
# ADDITIONAL LLM PROVIDER API KEYS
# ==========================================
# These are optional but enable testing of specific providers

# Azure OpenAI - Required for Azure-specific tests
# Set up at: https://azure.microsoft.com/en-us/products/ai-services/openai-service
# AZURE_API_KEY=your-azure-api-key-here
# AZURE_BASE_URL=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-09-01-preview

# Groq - Required for Groq provider tests (fast inference)
# Get your key at: https://console.groq.com/keys
# GROQ_API_KEY=your-groq-api-key-here

# Together AI - Required for Together.ai tests
# Get your key at: https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=your-together-api-key-here

# xAI (Grok) - Required for xAI/Grok tests
# Get your key at: https://x.ai/api
# XAI_API_KEY=your-xai-api-key-here

# DeepSeek - Required for DeepSeek tests
# Get your key at: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# AWS Bedrock - Required for Bedrock tests
# Set up at: https://aws.amazon.com/bedrock/
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_DEFAULT_REGION=us-east-1
# BEDROCK_ANTHROPIC_VERSION=bedrock-2023-05-31

# Mistral - Required for OCR and Pixtral tests
# Get your key at: https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=your-mistral-api-key-here

# ==========================================
# LOCAL LLM ENDPOINTS
# ==========================================
# For self-hosted or local model deployments

# Ollama - For local model testing
# Install from: https://ollama.ai/
# OLLAMA_BASE_URL=http://localhost:11434
# For Docker: OLLAMA_BASE_URL=http://host.docker.internal:11434

# vLLM - For high-performance local inference
# Set up at: https://docs.vllm.ai/
# VLLM_API_BASE=http://localhost:8000
# For Docker: VLLM_API_BASE=http://host.docker.internal:8000

# LMStudio - For desktop LLM testing
# Download from: https://lmstudio.ai/
# LMSTUDIO_BASE_URL=http://localhost:1234

# OpenLLM - For BentoML-based serving
# Set up at: https://github.com/bentoml/OpenLLM
# OPENLLM_AUTH_TYPE=none
# OPENLLM_API_KEY=your-openllm-api-key-here

# ==========================================
# TOOL & INTEGRATION API KEYS
# ==========================================
# Required for specific tools and integrations

# E2B (Sandbox Execution) - Required for @e2b_sandbox marked tests
# Get your key at: https://e2b.dev/dashboard
# E2B_API_KEY=your-e2b-api-key-here
# E2B_SANDBOX_TEMPLATE_ID=optional-custom-template-id

# Composio - Required for Composio integration tests
# Get your key at: https://app.composio.dev/
# COMPOSIO_API_KEY=your-composio-api-key-here

# Pinecone - Required for vector database tests
# Get your key at: https://app.pinecone.io/
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_SOURCE_INDEX=sources
# PINECONE_AGENT_INDEX=recall
# LETTA_ENABLE_PINECONE=false  # Set to true to enable Pinecone

# Tavily Search - For web search tool
# Get your key at: https://tavily.com/
# TAVILY_API_KEY=your-tavily-api-key-here

# Firecrawl - For web scraping tool
# Get your key at: https://www.firecrawl.dev/
# FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL configuration (required for production)

# Database connection settings
# LETTA_PG_DB=letta
# LETTA_PG_USER=letta
# LETTA_PG_PASSWORD=letta
# LETTA_PG_HOST=localhost
# LETTA_PG_PORT=5432

# Or use a full URI (overrides individual settings above)
# LETTA_PG_URI=postgresql://letta:letta@localhost:5432/letta

# Connection pool settings (optional)
# LETTA_PG_POOL_SIZE=25
# LETTA_PG_MAX_OVERFLOW=10
# LETTA_PG_POOL_TIMEOUT=30
# LETTA_PG_POOL_RECYCLE=1800

# ==========================================
# LETTA SERVER CONFIGURATION
# ==========================================

# Enable debug mode for more verbose logging
# LETTA_DEBUG=true

# Server host and port
# HOST=0.0.0.0
# PORT=8283

# Server security (for protected endpoints)
# SECURE=true
# LETTA_SERVER_PASSWORD=your-server-password

# Default model handles
# LETTA_DEFAULT_LLM_HANDLE=openai/gpt-4o-mini
# LETTA_DEFAULT_EMBEDDING_HANDLE=openai/text-embedding-3-small

# CORS origins (comma-separated)
# ACCEPTABLE_ORIGINS=http://localhost:3000,http://localhost:4200

# ==========================================
# LOGGING & TELEMETRY
# ==========================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LETTA_LOG_LEVEL=INFO

# Performance optimizations
# LETTA_LOGGING_ASYNC_LOGGING_ENABLED=true
# LETTA_LOGGING_LAZY_LOGGING_ENABLED=true

# OpenTelemetry configuration (minimal required)
# OTEL_SERVICE_NAME=letta-server
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ==========================================
# SPECIAL CONFIGURATIONS
# ==========================================

# For vLLM docker-compose tests
# LETTA_LLM_MODEL=your-model-name
# HUGGING_FACE_HUB_TOKEN=your-hf-token

# Multi-agent settings
# LETTA_MULTI_AGENT_CONCURRENT_SENDS=50

# Tool execution settings
# LETTA_TOOL_EXEC_DIR=/path/to/tool/sandbox
# LETTA_TOOL_SANDBOX_TIMEOUT=180

# Redis configuration (optional)
# LETTA_REDIS_HOST=localhost
# LETTA_REDIS_PORT=6379

# ==========================================
# TEST SUITE NOTES
# ==========================================
# 
# Running different test categories:
#
# 1. Core Tests (require OpenAI API key minimum):
#    pytest tests/ -m "not e2b_sandbox and not local_sandbox"
#
# 2. Provider-specific tests:
#    pytest tests/ -m "anthropic_basic"  # Requires ANTHROPIC_API_KEY
#    pytest tests/ -m "gemini_basic"     # Requires GEMINI_API_KEY
#    pytest tests/ -m "azure_basic"      # Requires AZURE_* keys
#
# 3. Sandbox tests:
#    pytest tests/ -m "local_sandbox"    # No API key required
#    pytest tests/ -m "e2b_sandbox"      # Requires E2B_API_KEY
#
# 4. Integration tests require specific API keys:
#    - Composio: COMPOSIO_API_KEY
#    - Pinecone: PINECONE_API_KEY and LETTA_ENABLE_PINECONE=true
#
# 5. Skip slow tests:
#    pytest tests/ -m "not slow"
#
# 6. Database tests require PostgreSQL:
#    docker-compose -f scripts/docker-compose.yml up -d postgres
#
# For detailed documentation, see docs/TESTING_API_KEYS.md
